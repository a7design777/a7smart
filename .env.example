# ── Tuya IoT Platform ────────────────────────────────────────
# iot.tuya.com → Cloud → ваш проєкт → Overview → Authorization Key
# Регіон має збігатися з ЦОД проєкту, інакше підпис не пройде:
#   Central Europe  https://openapi.tuyaeu.com
#   Western America https://openapi.tuyaus.com
#   China           https://openapi.tuyacn.com
#   India           https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
# Devices → Link App Account → колонка UID
TUYA_UID=

# ── База даних (Cloudflare D1) ──────────────────────────────
# dash.cloudflare.com → Workers & Pages → D1 → ваша база → Overview
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# My Profile → API Tokens → Create Token → право "D1 Edit" на акаунт
CF_D1_API_TOKEN=

# ── Застосунок ───────────────────────────────────────────────
# Згенерувати: npx tsx server/src/scripts/hash-password.ts 'ваш-пароль'
APP_PASSWORD_HASH=
# Згенерувати: openssl rand -hex 32
SESSION_SECRET=

NODE_ENV=development
PORT=3000

# Інтервал опитування Tuya, мс. Мінімум 60000.
# Прямо впливає на витрату квоти API — не знижувати без потреби.
POLL_INTERVAL_MS=300000

# ── Remihome (Remica) — необов'язково ────────────────────────
# API недокументований: використовується той самий інтерфейс, що й у
# веб-порталі proxy.remihome.es. Якщо не заповнено — провайдер вимкнений.
REMIHOME_EMAIL=
REMIHOME_PASSWORD=
# Число зі шляху порталу: proxy.remihome.es/<ЦЕ>/RemicaHome/...
REMIHOME_INSTALLATION=
